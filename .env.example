# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Both values are safe to expose in the browser:
# Vite inlines anything prefixed with VITE_ into the client bundle, and the
# anon key is protected by row level security, not by secrecy.
#
# Never put the service_role key in this file — it bypasses row level
# security entirely and must stay server-side.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
